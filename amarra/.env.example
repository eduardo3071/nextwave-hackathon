# ── Twilio ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# TwiML App apontando para https://SEU.ngrok.app/twiml/agent
TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# domínio ngrok SEM https:// — precisa ser fixo, o wss:// depende dele
PUBLIC_HOST=seu-dominio.ngrok.app
# Concorrência de chamadas simultâneas. 3 carriers × 2 pernas + 1 escalação = 7.
TWILIO_CONCURRENCY=10

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=            # service_role — SÓ no backend, nunca no Lovable

# ── Modelos ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
AGENT_MODEL=gpt-4.1-mini         # pequeno na conversa; grande só na extração
DEEPGRAM_API_KEY=                # nova-3, palavras com timestamp
AGENT_LANG=en                    # en | es | pt — idioma da saudação e das frases da política

# ── Escalação e recap ────────────────────────────────────────────────────
SUPERVISOR_PHONE=+55XXXXXXXXXXX
RESEND_API_KEY=
RECAP_TO=
# Se true, o SMS do recap vai TAMBÉM pro SUPERVISOR_PHONE (bom pro pitch).
SMS_CC_SUPERVISOR=false
DEMO_OPERATION_REF=MZO-GDL-4471
